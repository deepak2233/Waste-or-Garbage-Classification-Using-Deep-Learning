# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# Testing / linting
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Artefacts. Anchored with a leading slash so these only match at the
# repository root; src/wasteclf/data/ is a package, not a dataset.
/runs/
/artifacts/

# Dataset images are tracked with Git LFS (see .gitattributes), so they are
# not ignored. Everything else that lands in data/ is.
/data/*.zip
/data/*.tar
/data/*.tar.gz
/data/**/.ipynb_checkpoints/
*.h5
*.hdf5
*.keras
*.tflite
*.onnx

# The serverless function's model is produced by `wasteclf export`, not
# committed. Keep the directory, drop everything that lands in it.
/api/model/*
!/api/model/.gitkeep
*.pb
/saved_model/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
